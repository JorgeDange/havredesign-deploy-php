# HAVREDESIGN — copiar para .env e preencher
APP_NAME=HAVREDESIGN
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/havredesign/public
APP_LOCALE=pt

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=havre_design
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=havre_sessao
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

ADMIN_PATH=admin

MAIL_FROM_ADDRESS=info@havredesign.ao
MAIL_FROM_NAME=HAVREDESIGN
MAIL_ADMIN=info@havredesign.ao
MAIL_TRANSPORT=smtp

# SMTP (configuração para mail.havredesign.ao)
MAIL_HOST=mail.havredesign.ao
MAIL_PORT=465
MAIL_USERNAME=info@havredesign.ao
MAIL_PASSWORD=SUA_SENHA_DE_EMAIL_AQUI
MAIL_ENCRYPTION=ssl

LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_SEGUNDOS=900
